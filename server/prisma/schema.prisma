generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 작가 — 회원 인증은 과제 범위 밖이므로 프로필 수준만 관리
model Author {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  series    Series[]
}

// 작품
model Series {
  id        String   @id @default(cuid())
  slug      String   @unique
  authorId  String
  title     String
  synopsis  String
  genre     String
  weekday   String   @default("mon") // mon | tue | wed | thu | fri | sat | sun
  freeVolumeCount Int @default(1)
  previewEpisodeCount Int @default(0)
  coverUrl  String?
  status    String   @default("ongoing") // ongoing | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  seasons   Season[]
  orders    Order[]
}

// 시즌 — 단행본 주문의 단위
model Season {
  id       String    @id @default(cuid())
  seriesId String
  number   Int
  title    String?
  status   String    @default("ongoing") // ongoing | completed
  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes Episode[]
  orders   Order[]

  @@unique([seriesId, number])
}

// 에피소드 — zip(CBZ) 업로드 1건 = 에피소드 1화
model Episode {
  id          String   @id @default(cuid())
  seasonId    String
  number      Int
  title       String
  visibility  String   @default("public") // public | private(비공개 보관, 링크로만 접근)
  // 스튜디오 발행 파일의 저장 위치. 원고 교체 시 이전 파일 정리에 쓰며,
  // 시드처럼 스튜디오 밖에서 온 에피소드는 null이다.
  manuscriptDir String?
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  pages       Page[]
  candyEntitlements CandyEpisodeEntitlement[]

  @@unique([seasonId, number])
}

// 페이지 — zip 내 이미지 1장, 파일명 자연 정렬 순서를 order에 고정
model Page {
  id        String  @id @default(cuid())
  episodeId String
  order     Int
  imageUrl  String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, order])
}

// 단행본 주문 — 결제·배송·인증 없음. 기록과 상태 흐름 관리까지 (Lv2)
model Order {
  id                    String       @id @default(cuid())
  requestKey            String?      @unique
  entitlementToken      String       @unique @default(uuid())
  providerOrderId       String?      @unique
  candyWalletToken      String?
  candyBonus            Int          @default(0)
  seriesId              String
  seasonId              String
  volumeNumber          Int          @default(1)
  ordererName           String
  ordererType           String // reader(소장용) | creator(독립출판)
  quantity              Int          @default(1)
  coverType             String // softcover | hardcover
  bookSize              String // A5 | B5 등
  pageCount             Int?
  currency              String?      @default("KRW")
  unitPrice             Int?
  totalPrice            Int?
  estimatedBusinessDays Int?
  memo                   String?
  isDemo                 Boolean      @default(false)
  status                 String       @default("pending") // pending | processing | shipped | completed | canceled
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  series                 Series       @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  season                 Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  events                 OrderEvent[]
  candyWallet            CandyWallet? @relation(fields: [candyWalletToken], references: [token], onDelete: SetNull)
  candyTransaction       CandyTransaction?

  @@index([createdAt])
  @@index([isDemo, status, updatedAt])
  @@index([seasonId])
  @@index([seriesId])
}

// 주문 상태 변경 이력 — "내 책이 어디쯤인지" 타임라인 UI의 근거 데이터 (Lv3)
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  message   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// 공개 데모의 익명 지갑. 브라우저가 만든 UUID 토큰으로 지갑을 다시 찾는다.
model CandyWallet {
  token        String                    @id
  balance      Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  orders       Order[]
  transactions CandyTransaction[]
  entitlements CandyEpisodeEntitlement[]
}

// 캔디 지급·사용 원장. 주문과 요청 키의 unique 제약으로 중복 처리를 막는다.
model CandyTransaction {
  id           String       @id @default(cuid())
  walletToken  String
  type         String // order_bonus | episode_unlock | mock_charge
  amount       Int
  balanceAfter Int
  requestKey   String?      @unique
  orderId      String?      @unique
  episodeId    String?
  createdAt    DateTime     @default(now())
  wallet       CandyWallet  @relation(fields: [walletToken], references: [token], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([walletToken, createdAt])
}

// 캔디로 한 번 연 회차는 영구 열람한다.
model CandyEpisodeEntitlement {
  id          String      @id @default(cuid())
  walletToken String
  episodeId   String
  createdAt   DateTime    @default(now())
  wallet      CandyWallet @relation(fields: [walletToken], references: [token], onDelete: Cascade)
  episode     Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([walletToken, episodeId])
  @@index([episodeId])
}

// 책 패키징 서비스 신청 — 작가가 원고 묶음으로 실물 책 패키징을 접수한다.
// 실제 인쇄 API 호출 없이 접수 기록과 상태만 관리한다.
model PackagingRequest {
  id            String   @id @default(cuid())
  applicantName String
  bookTitle     String
  bookSize      String // A5 | B5
  coverType     String // softcover | hardcover
  quantity      Int      @default(1)
  memo          String?
  pageCount     Int
  manuscriptDir String
  status        String   @default("received") // received | reviewing | completed | canceled
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// 보안 감사 로그 — 원문 IP나 업로드 파일명 대신 최소 정보와 해시만 보관
model SecurityAuditEvent {
  id         String   @id @default(cuid())
  action     String
  outcome    String
  statusCode Int
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}
