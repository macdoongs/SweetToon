# 포트 충돌 시 변경
DB_PORT=5432
SERVER_PORT=4000
WEB_PORT=3000

# 과제 환경에서는 외부 Book Print API 대신 mock만 허용
PRINT_PROVIDER=mock

# SEO canonical/OG/sitemap 기준 URL
SITE_URL=https://sweettoon.katsuranbo.com

# 기본값은 자격증명 없이 실행되는 로컬 파일 저장소입니다.
ASSET_STORAGE_PROVIDER=filesystem

# Cloudflare R2 또는 MinIO(S3 호환) 사용 시에만 설정합니다.
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
R2_FORCE_PATH_STYLE=false

# Next.js 프록시를 거치지 않고 API를 직접 호출할 origin만 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=

# demo 보안 모드에서만 동작하는 실시간 시연 봇입니다.
# strict 모드에서는 ENABLED 값과 관계없이 비활성화됩니다.
REALTIME_BOT_ENABLED=true
REALTIME_BOT_AUTO_START=true
REALTIME_BOT_READER_COUNT=8
REALTIME_BOT_SPEED=normal

# 기본 demo 모드는 로그인 없는 과제 실행 흐름을 유지합니다.
# 운영에서는 strict와 충분히 긴 무작위 키/감사 해시 secret을 주입합니다.
API_SECURITY_MODE=demo
STUDIO_API_KEY=
OPERATIONS_API_KEY=
AUDIT_HASH_SECRET=

# 기본 Docker 실행은 이미지 구조 검증을 사용합니다.
# ClamAV 오버레이 사용 시 clamav로 설정됩니다.
MALWARE_SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
