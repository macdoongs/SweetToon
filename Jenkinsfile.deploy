pipeline {
    agent { label 'linux-build' }

    parameters {
        string(
            name: 'EXPECTED_COMMIT',
            defaultValue: '',
            description: 'CI에서 검증한 Git SHA. 비어 있으면 수동 배포로 간주합니다.'
        )
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        COMPOSE_PROJECT_NAME = 'sweettoon'
        COMPOSE_FILES = '-f docker-compose.yml -f docker-compose.prod.yml'
        DEPLOY_ENV_FILE = credentials('sweettoon-prod-env')
    }

    stages {
        stage('Preflight') {
            steps {
                sh '''
                    set -eu
                    actual_commit="$(git rev-parse HEAD)"
                    if [ -n "${EXPECTED_COMMIT}" ] && [ "${actual_commit}" != "${EXPECTED_COMMIT}" ]; then
                      echo "Refusing to deploy ${actual_commit}; CI validated ${EXPECTED_COMMIT}" >&2
                      exit 1
                    fi
                    case "${GIT_BRANCH:-}" in
                      origin/dev|*/dev) ;;
                      *)
                        echo "Refusing to deploy non-dev branch: ${GIT_BRANCH:-unknown}" >&2
                        exit 1
                        ;;
                    esac
                    export SITE_URL="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" url)"
                    export SITE_HOST="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" host)"
                    docker network inspect traefik-net >/dev/null
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" config --quiet
                '''
            }
        }

        stage('Build') {
            steps {
                retry(3) {
                    sh '''
                        set -eu
                        export SITE_URL="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" url)"
                        export SITE_HOST="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" host)"
                        COMPOSE_BAKE=false DOCKER_BUILDKIT=0 \
                          docker compose ${COMPOSE_FILES} \
                            --env-file "${DEPLOY_ENV_FILE}" build
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    set -eu
                    export SITE_URL="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" url)"
                    export SITE_HOST="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" host)"
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" up -d --wait --wait-timeout 120 --remove-orphans
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    set -eu
                    export SITE_URL="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" url)"
                    export SITE_HOST="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" host)"
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" ps
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" exec -T server \
                      node -e "fetch('http://localhost:4000/health/ready').then(r => { if (!r.ok) process.exit(1); console.log('api ready') }).catch(() => process.exit(1))"
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" exec -T web \
                      node -e "fetch('http://localhost:3000/health').then(r => { if (!r.ok) process.exit(1); console.log('web ready') }).catch(() => process.exit(1))"
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" exec -T web \
                      wget --quiet --output-document=/dev/null \
                        --header="Host: ${SITE_HOST}" http://traefik/
                    order_id="$(docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" exec -T web \
                      node -e "fetch('http://localhost:3000/api/orders').then(r => r.json()).then(body => { if (!body.items?.[0]?.id) process.exit(1); process.stdout.write(body.items[0].id) }).catch(() => process.exit(1))")"
                    docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" exec -T web sh -c \
                      "timeout 10 wget -qO- --header='Host: ${SITE_HOST}' \
                        'http://traefik/api/orders/${order_id}/events' | \
                        grep -m1 '^event: order'"
                '''
            }
        }
    }

    post {
        failure {
            sh '''
                export SITE_URL="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" url)"
                export SITE_HOST="$(sh scripts/resolve-site-config.sh "${DEPLOY_ENV_FILE}" host)"
                docker compose ${COMPOSE_FILES} --env-file "${DEPLOY_ENV_FILE}" logs --no-color --tail 200 || true
            '''
        }
    }
}
